POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traces
POSTGRES_PORT=5434
API_PORT=8000

REDIS_PORT=6380
MLFLOW_PORT=5001
MLFLOW_EXPERIMENT=trace-eval-runs

# Judge configuration used by the eval worker.
# provider: "openai" (needs OPENAI_API_KEY below) or "ollama" (needs a
# reachable Ollama server -- OLLAMA_HOST defaults to the Docker Desktop
# host-gateway address so a locally-running Ollama is reachable from the
# worker container).
JUDGE_PROVIDER=openai
JUDGE_MODEL=
JUDGE_NUM_RUNS=1
JUDGE_USE_HYBRID=true
JUDGE_TEMPERATURE=0.0
OPENAI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# Declared/intended worker concurrency, recorded on each eval run and
# logged to MLflow as a param. To actually run that many worker processes,
# start the stack with: docker compose up --scale worker=<N>
EVAL_WORKER_COUNT=1

# Port the worker's own Prometheus metrics HTTP server listens on inside the
# container (not published to the host, since scaling worker replicas would
# collide on the same host port; Prometheus scrapes it over the internal
# docker network as worker:9100 -- see infra/prometheus.yml).
WORKER_METRICS_PORT=9100

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
