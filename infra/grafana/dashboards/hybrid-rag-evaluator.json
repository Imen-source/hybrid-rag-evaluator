{
  "title": "Hybrid RAG Evaluator",
  "uid": "hybrid-rag-evaluator",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "tags": ["hybrid-rag-evaluator"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "description": "HTTP requests/sec on the ingestion API, by status code. Source: prometheus-fastapi-instrumentator's http_requests_total.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "legendFormat": "status {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Eval (judge) latency p50 / p95",
      "description": "Judge scoring latency per trace, recorded in tasks.py at the same point latency_ms is written to eval_results. Source: judge_latency_seconds histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(judge_latency_seconds_bucket{status=\"completed\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(judge_latency_seconds_bucket{status=\"completed\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Correctness score distribution (p10 / p50 / p90)",
      "description": "Distribution of the judge's correctness score across completed evals, shown as percentile bands over time. Source: eval_correctness histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.10, sum(rate(eval_correctness_bucket[5m])) by (le))",
          "legendFormat": "p10"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(eval_correctness_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(eval_correctness_bucket[5m])) by (le))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Relevance score distribution (p10 / p50 / p90)",
      "description": "Distribution of the judge's relevance score across completed evals. Source: eval_relevance histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.10, sum(rate(eval_relevance_bucket[5m])) by (le))",
          "legendFormat": "p10"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(eval_relevance_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(eval_relevance_bucket[5m])) by (le))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Groundedness score distribution (p10 / p50 / p90)",
      "description": "Distribution of the judge's groundedness score across completed evals. Source: eval_groundedness histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.10, sum(rate(eval_groundedness_bucket[5m])) by (le))",
          "legendFormat": "p10"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(eval_groundedness_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(eval_groundedness_bucket[5m])) by (le))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hallucination rate over time",
      "description": "Share of completed evals flagged hallucination=true. Source: eval_hallucination_total counter.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(eval_hallucination_total{hallucination=\"True\"}[5m])) / sum(rate(eval_hallucination_total[5m]))",
          "legendFormat": "hallucination rate"
        }
      ]
    }
  ]
}
